GEMINI_API_KEY=

# 本机电脑中的references目录
# 例如/Users/v.sophie.zhu/Documents/code/vibe-ui/vibe-motion/skills/interaction-library/references
TARGET_SKILLS_DIR=
TARGET_WEBSITE=

# ===本地代理===
# 用于解决网络问题（根据实际窗口填写，一般为7890）
HTTP_PROXY="http://127.0.0.1:7890"
HTTPS_PROXY="http://127.0.0.1:7890"

# ===视频资源上传===

# 在 R2 概览页面的右侧，或者浏览器 URL 中那一串由 32 位字母和数字组成的字符串（例如：abc123xyz...）。
CLOUDFLARE_ACCOUNT_ID=
#在 R2 页面右上角，点击 管理 R2 API 令牌 (Manage R2 API Tokens) -> 创建 API 令牌 (Create API Token)。
#创建成功后，Cloudflare 会唯一一次向你展示这两个长字符串，请立刻把它们复制下来。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 对应你已经建好的桶名：
R2_BUCKET_NAME=